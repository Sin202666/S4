local folder = game.ReplicatedStorage:FindFirstChild("_TmpAio")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "_TmpAio"
	folder.Parent = game.ReplicatedStorage
end
local function set(i, s)
	local v = folder:FindFirstChild(tostring(i)) or Instance.new("StringValue")
	v.Name = tostring(i)
	v.Parent = folder
	v.Value = s
	return #s
end
local lens = {}
lens[9] = set(9, [[]])
lens[10] = set(10, [[]])
lens[11] = set(11, [[]])
return lens
