local s = game.StarterPlayer.StarterPlayerScripts.Manager.CustomEUI
local b64 = '' .. '' .. ''
local ok, buf = pcall(function() return buffer.frombase64(b64) end)
if not ok then return "no buffer.frombase64: " .. tostring(buf) end
s.Source = buffer.tostring(buf)
return { len = #s.Source, hasGetIns = s.Source:find('InsMgr.GetIns', 1, true) ~= nil, hasCheck = s.Source:find('CheckTranslateByKey', 1, true) ~= nil }