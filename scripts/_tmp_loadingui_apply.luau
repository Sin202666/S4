local alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function b64decode(data: string): string
	local t = {}
	data = string.gsub(data, '[^'..alphabet..'=]', '')
	local i = 1
	while i <= #data do
		local a = string.find(alphabet, string.sub(data, i, i)) or 1
		local b = string.find(alphabet, string.sub(data, i + 1, i + 1)) or 1
		local c = string.find(alphabet, string.sub(data, i + 2, i + 2)) or 1
		local d = string.find(alphabet, string.sub(data, i + 3, i + 3)) or 1
		a -= 1; b -= 1; c -= 1; d -= 1
		local n = a * 262144 + b * 4096 + c * 64 + d
		local x = math.floor(n / 65536) % 256
		local y = math.floor(n / 256) % 256
		local z = n % 256
		table.insert(t, string.char(x))
		if string.sub(data, i + 2, i + 2) ~= '=' then table.insert(t, string.char(y)) end
		if string.sub(data, i + 3, i + 3) ~= '=' then table.insert(t, string.char(z)) end
		i += 4
	end
	return table.concat(t)
end
local parts = {
	[=[]=],
	[=[]=],
	[=[]=],
	[=[]=],
	[=[]=],
	[=[]=],
}
local src = b64decode(table.concat(parts))
local m = game.ReplicatedFirst.AllSideCode.FirstPreload.LoadingUI
m.Source = src
return string.format('ok len=%d head=%s', #src, string.sub(src, 1, 40))
